set bind-root false

let CStrCall cxxMemberCallExpr(
    callee(cxxMethodDecl(hasName("c_str")))
).bind("useless c_str call")

# Handle format inserts for the tinyformat-based printf-style functions
let FormatCallWithCStrArg callExpr(
    allOf(
        # Variadic format functions
        callee(anyOf(
            functionDecl(anyOf(
                hasName("::Str::Format"),
                hasName("::Log::Debug"),
                hasName("::Log::Verbose"),
                hasName("::Log::Notice"),
                hasName("::Log::Warn"),
                hasName("::Sys::Drop"),
                hasName("::Sys::Error")
            )),
            cxxMethodDecl(anyOf(
                # Log::Logger
                hasName("DebugExt"),
                hasName("VerboseExt"),
                hasName("NoticeExt"),
                hasName("WarnExt"),
                # Cmd::BaseCmd
                hasName("Print")
            ))
        )),
        forEachArgumentWithParam(
            CStrCall,
            # Only match the template-typed (const T&...) parms
            parmVarDecl(hasType(references(type(substTemplateTypeParmType()))))
        )
    )
)

# Match constructors of StringRef/string taking a single arg which is a c_str() expr
# (usually due to implicit conversion when passing a function argument)
let StringConstrucorFromCStr cxxConstructExpr(
    unless(isExpansionInSystemHeader()),
    hasDeclaration(cxxConstructorDecl(ofClass(anyOf(
        hasName("::Str::BasicStringRef"),
        hasName("::std::basic_string")
    )))),
    argumentCountIs(1),
    has(CStrCall)
)

match expr(anyOf(
    FormatCallWithCStrArg,
    StringConstrucorFromCStr
))
